# Local frontend: http://127.0.0.1:4317
# Local backend/API: http://127.0.0.1:5057
VITE_API_URL=http://127.0.0.1:5057
PORT=5057
RESEND_API_KEY=
CONTACT_RECIPIENT=abdulmuizlawal208@gmail.com
CONTACT_FROM=Portfolio <onboarding@resend.dev>
CORS_ORIGINS=http://127.0.0.1:4317,http://localhost:4317,http://127.0.0.1:4318,http://localhost:4318
# Set a long random value before using /admin. Never use a VITE_ prefix.
ADMIN_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
DATA_DIR=./data
POSTGRES_URL=
POSTGRES_SSL=true

# Optional S3-compatible object storage. Keep secrets server-side.
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
PLAUSIBLE_API_KEY=

# Optional, cookie-free Plausible analytics. Disabled unless explicitly enabled
# and a real deployed hostname is provided. Never put secrets in VITE_* values.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_DOMAIN=
# Leave the defaults empty to use Plausible's hosted script and event API.
VITE_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
VITE_ANALYTICS_API_URL=

# Set your real public origin to generate canonical URLs and the sitemap.
SITE_URL=
VITE_SITE_URL=
